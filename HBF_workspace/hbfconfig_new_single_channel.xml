<?xml version="1.0" encoding="us-ascii"?>
<Execution_Parameter_Set>
	<Host_Parameter_Set>
		<!-- Host 接口: 32 Lanes * 64 GB/s = 2048 GB/s (匹配 HBF 读带宽) -->
		<PCIe_Lane_Bandwidth>2048.0</PCIe_Lane_Bandwidth>
		<PCIe_Lane_Count>32</PCIe_Lane_Count>
		<SATA_Processing_Delay>0</SATA_Processing_Delay>
		<Enable_ResponseTime_Logging>false</Enable_ResponseTime_Logging>
		<ResponseTime_Logging_Period_Length>1000000</ResponseTime_Logging_Period_Length>
	</Host_Parameter_Set>
	<Device_Parameter_Set>
		<Seed>321</Seed>
		<Enabled_Preconditioning>false</Enabled_Preconditioning>
		<Memory_Type>FLASH</Memory_Type>
		<HostInterface_Type>NVME</HostInterface_Type>
		<!-- 队列深度设大，以支持极高的并发 -->
		<IO_Queue_Depth>65535</IO_Queue_Depth>
		<Queue_Fetch_Size>1024</Queue_Fetch_Size>
		<Caching_Mechanism>SIMPLE</Caching_Mechanism>
		<Data_Cache_Sharing_Mode>SHARED</Data_Cache_Sharing_Mode>
		<!-- DRAM Cache 设为 1GB 或更大，以缓冲 2TB/s 的流量 -->
		<Data_Cache_Capacity>1048576</Data_Cache_Capacity>
		<Data_Cache_DRAM_Row_Size>8192</Data_Cache_DRAM_Row_Size>
		<!-- DRAM 速率必须足够快，否则 DRAM 成为瓶颈。设为 3200MT/s 或更高 -->
		<Data_Cache_DRAM_Data_Rate>3200000</Data_Cache_DRAM_Data_Rate>
		<Data_Cache_DRAM_Data_Busrt_Size>128</Data_Cache_DRAM_Data_Busrt_Size>
		<Data_Cache_DRAM_tRCD>1</Data_Cache_DRAM_tRCD>
		<Data_Cache_DRAM_tCL>1</Data_Cache_DRAM_tCL>
		<Data_Cache_DRAM_tRP>1</Data_Cache_DRAM_tRP>
		<Address_Mapping>PAGE_LEVEL</Address_Mapping>
		<Ideal_Mapping_Table>true</Ideal_Mapping_Table>
		<!-- 增大 CMT 以适应大量 Mapping 表 -->
		<!-- <CMT_Capacity>524288</CMT_Capacity>
		<CMT_Sharing_Mode>SHARED</CMT_Sharing_Mode>
		<Plane_Allocation_Scheme>CWPD</Plane_Allocation_Scheme>
		<Transaction_Scheduling_Policy>PRIORITY_OUT_OF_ORDER</Transaction_Scheduling_Policy>
		<Overprovisioning_Ratio>0.07</Overprovisioning_Ratio>
		<GC_Exec_Threshold>0.05000</GC_Exec_Threshold>
		<GC_Block_Selection_Policy>RGA</GC_Block_Selection_Policy>
		<Use_Copyback_for_GC>false</Use_Copyback_for_GC>
		<Preemptible_GC_Enabled>true</Preemptible_GC_Enabled>
		<GC_Hard_Threshold>0.005000</GC_Hard_Threshold>
		<Dynamic_Wearleveling_Enabled>true</Dynamic_Wearleveling_Enabled>
		<Static_Wearleveling_Enabled>true</Static_Wearleveling_Enabled>
		<Static_Wearleveling_Threshold>100</Static_Wearleveling_Threshold>
		<Preferred_suspend_erase_time_for_read>700000</Preferred_suspend_erase_time_for_read>
		<Preferred_suspend_erase_time_for_write>700000</Preferred_suspend_erase_time_for_write>
		<Preferred_suspend_write_time_for_read>100000</Preferred_suspend_write_time_for_read> -->
		
		<!-- HBF 关键通道参数: 32通道, 8 Byte宽 (64bit), 8000 MT/s -->
		<Flash_Channel_Count>1</Flash_Channel_Count>
		<Flash_Channel_Width>8</Flash_Channel_Width>
		<Channel_Transfer_Rate>12500</Channel_Transfer_Rate>
		<Chip_No_Per_Channel>24</Chip_No_Per_Channel>
		<Flash_Comm_Protocol>HBF</Flash_Comm_Protocol>
		
		<Flash_Parameter_Set>

			<Flash_Technology>SLC</Flash_Technology>
			<CMD_Suspension_Support>ERASE</CMD_Suspension_Support>
			
			<!-- tR sequential = 2us -->
			<Page_Read_Latency_LSB>2000</Page_Read_Latency_LSB>
			<Page_Read_Latency_CSB>2000</Page_Read_Latency_CSB>
			<Page_Read_Latency_MSB>2000</Page_Read_Latency_MSB>
			
			<!-- tPROG = 50us -->
			<Page_Program_Latency_LSB>50000</Page_Program_Latency_LSB>
			<Page_Program_Latency_CSB>50000</Page_Program_Latency_CSB>
			<Page_Program_Latency_MSB>50000</Page_Program_Latency_MSB>

			<Block_Erase_Latency>5000000</Block_Erase_Latency>
			<Block_PE_Cycles_Limit>50000</Block_PE_Cycles_Limit>
			<Suspend_Erase_Time>500000</Suspend_Erase_Time>
			<Suspend_Program_Time>50000</Suspend_Program_Time>

			<Die_No_Per_Chip>1</Die_No_Per_Chip>
			<Plane_No_Per_Die>1</Plane_No_Per_Die>

			<Block_No_Per_Plane>105</Block_No_Per_Plane>
			<Page_No_Per_Block>1664</Page_No_Per_Block>
			
			<!-- Page Size 8KB -->
			<Page_Capacity>8192</Page_Capacity>
			<Page_Metadat_Capacity>0</Page_Metadat_Capacity>
		</Flash_Parameter_Set>
	</Device_Parameter_Set>
</Execution_Parameter_Set>